    "\n",
    "# ---- Cell 9: Run Optuna study ----\n",
    "study = optuna.create_study(\n",
    "    direction=\"minimize\",\n",
    "    sampler=optuna.samplers.TPESampler(seed=42),\n",
    ")\n",
    "\n",
    "# Warm-start: seed the sampler with the manual starting point\n",
    "study.enqueue_trial({\n",
    "    \"OCV\": 0.95, \"i0_c_ref\": 0.20, \"kappa_c\": 1.0, \"tau\": 2.0,\n",
    "    \"Re\": 2.0e-6, \"epsilon_mc\": 0.399, \"epsilon_gdl\": 0.6,\n",
    "    \"epsilon_c\": 0.189, \"epsilon_cl\": 0.3, \"a_slim\": 0.01,\n",
    "    \"b_slim\": 0.5, \"a_switch\": 0.2, \"Hcl\": 1e-5, \"Hgdl\": 2e-4,\n",
    "})\n",
    "\n",
    "study.optimize(make_objective(CHOSEN_COND),\n",
    "                            n_trials=N_TRIALS,\n",
    "                            timeout=TIMEOUT,\n",
    "                            n_jobs=N_JOBS,\n",
    "                            show_progress_bar=True)\n",
    "\n",
    "best_params = study.best_params\n",
    "print(f\"\\nCompleted {len(study.trials)} trials.\")\n",
    "print(f\"Best SSE : {study.best_value:.6f}\")\n",
    "print(f\"\\n{'Parameter':15s}  {'Best fit':>12s}\")\n",
    "print(\"-\" * 30)\n",
    "for k, v in best_params.items():\n",
    "    print(f\"  {k:13s}  {v:12.4g}\")\n"
   ]
